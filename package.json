{
  "name": "annotatetofix",
  "description": "Note problems on the elements of your own website and copy one prompt for a coding agent.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  }
}
